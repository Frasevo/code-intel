{
  "name": "@frasevo/code-intel",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "Offline code inventory, TypeScript graphs, API catalog, docs and versioned context/evidence queries",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "scan": "node src/cli.ts scan",
    "import": "node src/cli.ts import",
    "validate": "node src/cli.ts validate",
    "test": "node --test tests/*.test.ts",
    "graph": "node src/cli.ts graph",
    "graph:validate": "node src/cli.ts graph-validate",
    "typecheck": "tsc --noEmit",
    "api": "node src/cli.ts api",
    "api:validate": "node src/cli.ts api-validate",
    "api:route": "node src/cli.ts api-route",
    "docs": "node src/cli.ts docs",
    "docs:validate": "node src/cli.ts docs-validate",
    "docs:file": "node src/cli.ts docs-file",
    "docs:target": "node src/cli.ts docs-target",
    "context:select": "node src/cli.ts context-select",
    "context:evidence": "node src/cli.ts context-evidence",
    "context:validate": "node src/cli.ts context-validate",
    "mcp": "node src/cli.ts mcp-stdio"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0"
  }
}
