{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.frasevo.dev/doc-trace.v1.schema.json",
  "$comment": "Offline private trace of Markdown links to included repository files and declared Next.js API routes; no runtime verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producerVersion",
    "artifactId",
    "repoId",
    "capturedAt",
    "sensitivity",
    "sources",
    "coverage",
    "documents",
    "references",
    "stats"
  ],
  "properties": {
    "schemaVersion": {
      "const": "doc-trace/v1"
    },
    "producerVersion": {
      "type": "string",
      "minLength": 1
    },
    "artifactId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "repoId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sensitivity": {
      "const": "private"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotArtifactId",
        "graphArtifactId",
        "apiArtifactId",
        "includedFilesHash",
        "commitSha",
        "dirty"
      ],
      "properties": {
        "snapshotArtifactId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "graphArtifactId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "apiArtifactId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "includedFilesHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commitSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntax",
        "execution",
        "anchoring",
        "source"
      ],
      "properties": {
        "syntax": {
          "const": "markdown-links-and-reference-links"
        },
        "execution": {
          "const": "not-performed"
        },
        "anchoring": {
          "const": "markdown-headings-only"
        },
        "source": {
          "const": "included-files-only"
        }
      }
    },
    "documents": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "headings"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "headings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slug",
                "line"
              ],
              "properties": {
                "slug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "line",
          "column",
          "syntax",
          "kind",
          "target",
          "fragment",
          "status"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "syntax": {
            "enum": [
              "inline-link",
              "reference-link"
            ]
          },
          "kind": {
            "enum": [
              "file",
              "api",
              "external",
              "unknown"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "fragment": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "resolved",
              "unknown",
              "external"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents",
        "headings",
        "references",
        "resolved",
        "unknown",
        "external"
      ],
      "properties": {
        "documents": {
          "type": "integer",
          "minimum": 0
        },
        "headings": {
          "type": "integer",
          "minimum": 0
        },
        "references": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "external": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
